---
import Navbar from '../components/Navbar.svelte';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.svelte';
import ContributeModal from '../components/ContributeModal.svelte';
import { getAllCheatsheets } from '../lib/cheatsheets';
import { getStarCount } from '../lib/github';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'BroHelpMe — Quick Reference for Developers',
	description = 'Free, fast, and clean developer cheat sheets, command line references, and syntax guides without clutter.'
} = Astro.props;

const allSheets = getAllCheatsheets();
const starCount = await getStarCount();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#070a12" media="(prefers-color-scheme: dark)" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />

		<!-- Zero-flash Theme Hydration Script & Theme Helpers -->
		<script is:inline>
			(function() {
				function applyTheme(isDark) {
					if (isDark) {
						document.documentElement.classList.add('dark');
						localStorage.setItem('theme', 'dark');
					} else {
						document.documentElement.classList.remove('dark');
						localStorage.setItem('theme', 'light');
					}
					// Keep the browser chrome colour in sync with the *toggled* theme.
					syncThemeColor(isDark);
					window.dispatchEvent(new CustomEvent('theme-changed', { detail: { isDark } }));
				}

				function syncThemeColor(isDark) {
					var metas = document.querySelectorAll('meta[name="theme-color"]');
					for (var i = 0; i < metas.length; i++) {
						metas[i].setAttribute('content', isDark ? '#070a12' : '#f8fafc');
						metas[i].removeAttribute('media');
					}
				}

				window.__setTheme = function(theme) {
					applyTheme(theme === 'dark');
				};

				window.__toggleTheme = function() {
					const isDark = document.documentElement.classList.contains('dark');
					applyTheme(!isDark);
				};

				const storedTheme = localStorage.getItem('theme');
				let isDark;
				if (storedTheme === 'light') {
					isDark = false;
				} else if (storedTheme === 'dark') {
					isDark = true;
				} else {
					isDark = !window.matchMedia('(prefers-color-scheme: light)').matches;
				}
				document.documentElement.classList.toggle('dark', isDark);
				syncThemeColor(isDark);
			})();
		</script>
	</head>
	<body class="bg-(--background) text-(--foreground) antialiased min-h-screen flex flex-col font-sans transition-colors duration-200">
		<Navbar client:load starCount={starCount} />

		<main class="flex-1 w-full overflow-x-hidden">
			<slot />
		</main>

		<Footer />

		<!-- Global Command Palette Search -->
		<CommandPalette client:load sheets={allSheets} />

		<!-- Global Contribute / Add Cheatsheet Modal -->
		<ContributeModal client:load />
	</body>
</html>
