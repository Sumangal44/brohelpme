---
import '../styles/global.css';
import Nav from '../components/Nav.svelte';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noIndex?: boolean;
}
const { title, description = site.description, ogImage, jsonLd, noIndex = false } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

/** Healthcare structured data — always present on every page. */
const medicalClinic: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': ['MedicalClinic', 'LocalBusiness'],
	'@id': `${site.url}/#clinic`,
	name: site.name,
	alternateName: site.nameBn,
	description: site.description,
	url: site.url,
	telephone: `+${site.phone.display.replace(/\D/g, '')}`,
	email: site.email,
	foundingDate: String(site.established),
	image: ogImage ?? `${site.url}/favicon.svg`,
	sameAs: [site.facebook],
	address: {
		'@type': 'PostalAddress',
		streetAddress: site.address.street,
		addressLocality: 'Midnapore',
		addressRegion: 'West Bengal',
		postalCode: site.address.postal,
		addressCountry: 'IN'
	},
	geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
	hasMap: site.links.gMapsSearch,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '21:00'
		}
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: site.rating.value,
		bestRating: site.rating.max,
		ratingCount: site.rating.reviews
	},
	medicalSpecialty: 'https://schema.org/MedicalSpecialty' // broad umbrella; verified departments live in data/specialities.ts
};

const breadcrumb =
	Astro.url.pathname !== '/'
		? {
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: [
					{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
					{ '@type': 'ListItem', position: 2, name: title ?? 'Page', item: canonical }
				]
			}
		: null;

const schemaBlocks = [medicalClinic, breadcrumb, jsonLd].filter(Boolean).flat() as Record<string, unknown>[];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noIndex && <meta name="robots" content="noindex" />}
		<meta name="theme-color" content="#102A43" />

		<!-- Open Graph / Twitter -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en_IN" />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		{schemaBlocks.map((block) => (
			<script type="application/ld+json" set:html={JSON.stringify(block)} />
		))}

		<!-- Motion failsafe: content stays visible if the GSAP bundle never boots. -->
		<script is:inline>
			(function () {
				try {
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
					document.documentElement.classList.add('gsap-ready');
					window.__kdcMotion = { booted: false };
					setTimeout(function () {
						if (window.__kdcMotion && !window.__kdcMotion.booted) {
							document.documentElement.classList.remove('gsap-ready');
						}
					}, 5000);
				} catch (e) {
					document.documentElement.classList.remove('gsap-ready');
				}
			})();
		</script>
	</head>

	<body class="antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-navy focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
		>
			Skip to content
		</a>

		<Nav currentPath={Astro.url.pathname} />

		<main id="main" class="pt-20 sm:pt-24">
			<slot />
		</main>

		<Footer />

		<!-- Mobile sticky actions -->
		<div
			class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-hairline bg-offwhite/90 px-4 py-3 backdrop-blur-lg sm:hidden print:hidden"
		>
			<a href={site.phone.tel} class="btn btn-ghost flex-1 px-4 py-3 text-sm"> Call Now </a>
			<a href="/appointment" class="btn btn-primary flex-1 px-4 py-3 text-sm"> Book Appointment </a>
		</div>

		<script>
			import { initMotion } from '../lib/motion';

			const boot = () => initMotion();
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', boot, { once: true });
			} else {
				boot();
			}
		</script>

		<style is:global>
			/* space for the mobile sticky action bar */
			@media (max-width: 639px) {
				footer {
					padding-bottom: 4.5rem;
				}
			}
		</style>
	</body>
</html>
