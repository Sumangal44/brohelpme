---
import { getIcon } from '../../lib/icons';

interface Props {
	icon?: string;
	title: string;
	description?: string;
	actionLabel?: string;
	href?: string;
}
const { icon = 'info', title, description, actionLabel, href = '/contact' } = Astro.props;
const Icon = getIcon(icon);
---

<div
	class="soft-card mx-auto flex max-w-2xl flex-col items-center gap-4 px-8 py-12 text-center"
	data-reveal
>
	<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-medical/10 text-medical">
		<Icon size={26} strokeWidth={2} />
	</span>
	<h3 class="text-xl font-bold sm:text-2xl">{title}</h3>
	{description && <p class="max-w-md text-sm leading-relaxed text-ink-soft sm:text-base">{description}</p>}
	{actionLabel && (
		<a href={href} class="btn btn-primary mt-2 text-sm">
			{actionLabel}
			<svg class="arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M2 8 H14 M9 3 L14 8 L9 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	)}
</div>
