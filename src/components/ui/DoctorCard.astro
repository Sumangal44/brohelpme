---
import type { Doctor } from '../../data/doctors';
import { getIcon } from '../../lib/icons';

interface Props {
	doctor: Doctor;
}
const { doctor } = Astro.props;

const Calendar = getIcon('calendar-check');
const Clock = getIcon('clock');
const Arrow = getIcon('arrow-up-right');
const Award = getIcon('badge-check');

const initials = doctor.name
	.replace(/^Dr\.?\s*/i, '')
	.split(/\s+/)
	.map((w) => w[0])
	.slice(0, 2)
	.join('')
	.toUpperCase();
---

<article class="soft-card group flex flex-col overflow-hidden" data-reveal-child>
	<!-- photo / monogram -->
	<div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-navy to-medical">
		{doctor.photo ? (
			<img
				src={doctor.photo}
				alt={doctor.name}
				width="640"
				height="480"
				loading="lazy"
				class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
			/>
		) : (
			<div class="flex h-full w-full items-center justify-center">
				<span class="font-display text-6xl font-extrabold text-white/25">{initials}</span>
			</div>
		)}
		<span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-[0.68rem] font-bold uppercase tracking-widest text-navy backdrop-blur">
			{doctor.speciality}
		</span>
	</div>

	<div class="flex flex-1 flex-col p-6">
		<h3 class="text-xl font-extrabold leading-snug">
			<a href={`/doctors/${doctor.slug}`} class="transition group-hover:text-medical">{doctor.name}</a>
		</h3>
		<p class="mt-1.5 flex items-center gap-1.5 text-sm font-semibold text-medical">
			<Award size={15} />
			{doctor.qualifications}
		</p>

		{doctor.experienceYears ? (
			<p class="mt-1 text-sm text-ink-soft">{doctor.experienceYears}+ years of experience</p>
		) : null}

		{doctor.schedule.length > 0 && (
			<ul class="mt-4 space-y-2 border-t border-hairline pt-4 text-sm text-ink-soft">
				{doctor.schedule.map((s) => (
					<li class="flex items-start gap-2.5">
						<Calendar size={15} class="mt-0.5 shrink-0 text-teal" />
						<span>
							<strong class="font-semibold text-navy">{s.days}</strong>
							<span class="block text-xs">{s.time}</span>
						</span>
					</li>
				))}
			</ul>
		)}

		<a
			href={`/doctors/${doctor.slug}`}
			class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-navy transition group-hover:text-medical"
		>
			View Profile
			<Arrow size={15} class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" />
		</a>
	</div>
</article>
