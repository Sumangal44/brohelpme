---
interface Props {
	value: number;
	max?: number;
	class?: string;
}
const { value, max = 5, class: className = '' } = Astro.props;
const filled = Math.round(value);
---

<span class={`inline-flex items-center gap-0.5 ${className}`} role="img" aria-label={`${value} out of ${max} stars`}>
	{Array.from({ length: max }).map((_, i) => (
		<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z"
				fill={i < filled ? '#F5B301' : 'none'}
				stroke={i < filled ? '#F5B301' : '#C6D2DC'}
				stroke-width="1.6"
				stroke-linejoin="round"
			/>
		</svg>
	))}
</span>
