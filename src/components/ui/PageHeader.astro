---
interface Props {
	eyebrow: string;
	title: string;
	titleBn?: string;
	description?: string;
}
const { eyebrow, title, titleBn, description } = Astro.props;
---

<section class="relative overflow-hidden bg-navy">
	<div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-medical/30 blur-[110px]" aria-hidden="true"></div>
	<div class="pointer-events-none absolute -bottom-32 left-10 h-72 w-72 rounded-full bg-teal/20 blur-[110px]" aria-hidden="true"></div>
	<svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.07]" viewBox="0 0 1200 300" fill="none" aria-hidden="true" preserveAspectRatio="none">
		<path d="M0 210 H260 l30 -60 38 150 36 -132 28 74 22 -28 H1200" stroke="white" stroke-width="2.5" stroke-linejoin="round" />
	</svg>

	<div class="editorial-container relative py-20 sm:py-24">
		<nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-white/50" data-hero>
			<a href="/" class="transition hover:text-white">Home</a>
			<span aria-hidden="true">/</span>
			<span class="text-teal-light">{eyebrow}</span>
		</nav>

		<p class="eyebrow text-teal-light" data-hero>{eyebrow}</p>
		<h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.05] text-white sm:text-5xl lg:text-[3.6rem]" data-hero>
			{title}
		</h1>
		{titleBn && <p class="font-bengali mt-4 text-lg text-teal-light" data-hero>{titleBn}</p>}
		{description && (
			<p class="mt-5 max-w-2xl text-base leading-relaxed text-white/70 sm:text-lg" data-hero>{description}</p>
		)}
	</div>
</section>
