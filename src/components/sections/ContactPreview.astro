---
import { site } from '../../data/site';
import { getIcon } from '../../lib/icons';
import SectionHeading from '../ui/SectionHeading.astro';

const MapPin = getIcon('map-pin');
const Phone = getIcon('phone');
const Clock = getIcon('clock');
const Navigation = getIcon('navigation');
const Message = getIcon('message-circle');
const Mail = getIcon('mail');
---

<section class="section-pad bg-offwhite" id="contact">
	<div class="editorial-container">
		<SectionHeading
			eyebrow="Visit us"
			title="Come see us in Midnapore."
			titleBn="মিদনাপুরে আমাদের খুঁজে নিন"
			description="Find the chamber, get directions or give us a call — whichever is easiest for you."
		/>

		<div class="mt-12 grid gap-8 lg:grid-cols-12">
			<!-- Map -->
			<div class="lg:col-span-7" data-reveal>
				<div class="overflow-hidden rounded-[2rem] border border-hairline bg-white p-2 shadow-card">
					<iframe
						src={site.links.gMapsEmbed}
						title="Map to Kathamala Doctors Chamber"
						class="h-[340px] w-full rounded-[1.6rem] border-0 sm:h-[420px]"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
				</div>
			</div>

			<!-- Details -->
			<div class="flex flex-col gap-4 lg:col-span-5" data-reveal-group>
				<div class="soft-card flex items-start gap-4 p-6" data-reveal-child>
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-medical/10 text-medical">
						<MapPin size={20} />
					</span>
					<div>
						<h3 class="text-sm font-extrabold uppercase tracking-widest text-navy">Address</h3>
						<p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{site.address.street},<br />{site.address.locality}, {site.address.region} {site.address.postal}</p>
					</div>
				</div>

				<div class="soft-card flex items-start gap-4 p-6" data-reveal-child>
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-teal/15 text-teal">
						<Phone size={20} />
					</span>
					<div>
						<h3 class="text-sm font-extrabold uppercase tracking-widest text-navy">Phone</h3>
						<a href={site.phone.tel} class="mt-1.5 block text-lg font-bold text-navy transition hover:text-medical">
							{site.phone.display}
						</a>
						<a href={`mailto:${site.email}`} class="flex items-center gap-1.5 text-sm text-ink-soft transition hover:text-medical">
							<Mail size={14} /> {site.email}
						</a>
					</div>
				</div>

				<div class="soft-card flex items-start gap-4 p-6" data-reveal-child>
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-navy/8 text-navy">
						<Clock size={20} />
					</span>
					<div class="w-full">
						<h3 class="text-sm font-extrabold uppercase tracking-widest text-navy">Opening hours</h3>
						<ul class="mt-2 space-y-1.5 text-sm text-ink-soft">
							{site.hours.map((h) => (
								<li class="flex items-center justify-between gap-4 border-b border-hairline/70 pb-1.5 last:border-0">
									<span>{h.days}</span>
									<span class="font-semibold text-navy">{h.time}</span>
								</li>
							))}
						</ul>
						<p class="mt-2 text-xs text-ink-soft">{site.hoursNote}</p>
					</div>
				</div>

				<div class="grid grid-cols-1 gap-3 sm:grid-cols-3" data-reveal-child>
					<a href={site.links.gMapsDirections} target="_blank" rel="noopener" class="btn btn-primary px-4 py-3.5 text-xs">
						<Navigation size={15} /> Get Directions
					</a>
					<a href={site.phone.tel} class="btn btn-ghost px-4 py-3.5 text-xs">
						<Phone size={15} /> Call Now
					</a>
					<a href={site.phone.whatsapp} target="_blank" rel="noopener" class="btn btn-teal px-4 py-3.5 text-xs">
						<Message size={15} /> WhatsApp
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
