---
import { publishedDoctors } from '../../data/doctors';
import { getIcon } from '../../lib/icons';
import SectionHeading from '../ui/SectionHeading.astro';
import DoctorCard from '../ui/DoctorCard.astro';
import EmptyState from '../ui/EmptyState.astro';
import { site } from '../../data/site';

const Arrow = getIcon('arrow-right');
---

<section class="section-pad bg-offwhite">
	<div class="editorial-container">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<SectionHeading
				eyebrow="Our team"
				title="Meet Our Medical Professionals."
				titleBn="আমাদের চিকিৎসক পরিচিতি"
				description="Experienced doctors who take the time to listen, explain and treat with compassion."
			/>
			{publishedDoctors.length > 0 && (
				<a href="/doctors" class="btn btn-ghost shrink-0 text-sm" data-reveal>
					All doctors
					<Arrow size={15} class="arrow" strokeWidth={2.2} />
				</a>
			)}
		</div>

		{publishedDoctors.length > 0 ? (
			<div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
				{publishedDoctors.slice(0, 3).map((doctor) => (
					<DoctorCard doctor={doctor} />
				))}
			</div>
		) : (
			<div class="mt-12">
				<EmptyState
					icon="stethoscope"
					title="Doctor profiles are being updated"
					description={`Verified profiles — names, qualifications, specialities and consultation schedules — will appear here shortly. To know which doctors are visiting today, please call ${site.phone.display}.`}
					actionLabel={`Call ${site.phone.display}`}
					href={site.phone.tel}
				/>
			</div>
		)}
	</div>
</section>
