---
import { site } from '../../data/site';
import { hasImage } from '../../lib/images';
import { getIcon } from '../../lib/icons';
import SectionHeading from '../ui/SectionHeading.astro';

const aboutPhoto = hasImage(site.images.about) ? site.images.about : null;
const Arrow = getIcon('arrow-right');
const Check = getIcon('check');

const principles = [
	{
		title: 'Patient-first conversations',
		text: 'Time to listen, explain and answer questions before anything else.'
	},
	{
		title: 'Clear, honest guidance',
		text: 'Straight answers about next steps — no confusion, no pressure.'
	},
	{
		title: 'Care that is easy to reach',
		text: 'Call, WhatsApp or walk in — help finding the right doctor, close to home.'
	}
];
---

<section class="section-pad bg-white">
	<div class="editorial-container">
		<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
			<!-- Visual -->
			<div class="lg:col-span-5">
				<div class="relative" data-parallax="16">
					<div class="aspect-[4/5] overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-navy via-navy-700 to-medical shadow-float" data-reveal-mask>
						{aboutPhoto ? (
							<img
								src={aboutPhoto}
								alt="Inside Kathamala Doctors Chamber"
								width="900"
								height="1125"
								loading="lazy"
								class="h-full w-full object-cover"
							/>
						) : (
							<div class="flex h-full w-full flex-col justify-between p-8">
								<svg viewBox="0 0 300 200" class="w-full" fill="none" aria-hidden="true">
									<path
										d="M0 130 H70 l16 -36 22 86 20 -76 15 44 12 -18 H300"
										stroke="rgba(87,199,187,0.8)"
										stroke-width="3"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
									<circle cx="245" cy="55" r="46" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
									<circle cx="245" cy="55" r="30" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
								</svg>
								<div>
									<p class="text-xs font-bold uppercase tracking-[0.25em] text-teal-light">Since {site.established}</p>
									<p class="font-bengali mt-3 text-lg leading-relaxed text-white/85">{site.nameBn}</p>
									<p class="mt-2 text-sm leading-relaxed text-white/60">
										Rabindra Nagar, Midnapore
									</p>
								</div>
							</div>
						)}
					</div>

					<div class="absolute -right-4 -top-6 hidden rounded-2xl border border-hairline bg-white px-5 py-4 shadow-card sm:block lg:-right-8">
						<p class="font-display text-3xl font-extrabold text-navy">{site.rating.value}</p>
						<p class="text-xs font-semibold text-ink-soft">Google rating</p>
					</div>
				</div>
			</div>

			<!-- Copy -->
			<div class="lg:col-span-7">
				<SectionHeading
					eyebrow="About the chamber"
					title="Healthcare Built Around People."
					titleBn="মানুষের পাশে, প্রতিটা পথে।"
					description="Kathamala Doctors Chamber has served families in and around Rabindra Nagar since 2012 — a neighbourhood chamber where experienced professionals, an approachable reception and honest communication come together."
				/>

				<div class="mt-8 space-y-4" data-reveal>
					<p class="text-base leading-relaxed text-ink-soft">
						We believe good healthcare starts with being heard. Every visit begins with a
						conversation — your concerns, your history, your questions — so the doctor can give
						you the time and clarity you deserve.
					</p>
					<p class="text-base leading-relaxed text-ink-soft">
						Our philosophy is simple: <strong class="text-navy">people first, always.</strong>
						From the moment you call to the moment you leave, someone is there to guide you.
					</p>
				</div>

				<ul class="mt-8 grid gap-4 sm:grid-cols-1" data-reveal-group>
					{principles.map((p) => (
						<li class="flex items-start gap-4 rounded-2xl border border-hairline bg-offwhite px-5 py-4 transition hover:border-teal/50 hover:bg-white" data-reveal-child>
							<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal/15 text-teal">
								<Check size={15} strokeWidth={2.6} />
							</span>
							<span>
								<strong class="block text-sm font-bold text-navy">{p.title}</strong>
								<span class="mt-0.5 block text-sm text-ink-soft">{p.text}</span>
							</span>
						</li>
					))}
				</ul>

				<div class="mt-9" data-reveal>
					<a href="/about" class="btn btn-ghost text-sm">
						More about us
						<Arrow size={15} class="arrow" strokeWidth={2.2} />
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
