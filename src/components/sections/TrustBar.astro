---
import type { Component } from 'svelte';
import { site } from '../../data/site';
import { getIcon } from '../../lib/icons';
import Stars from '../ui/Stars.astro';

const Heart = getIcon('heart-handshake');
const MapPin = getIcon('map-pin');

interface Item {
	icon: Component | null;
	value: string;
	label: string;
	href: string;
	stars?: boolean;
}

const items: Item[] = [
	{
		icon: null,
		value: `${site.rating.value} / ${site.rating.max}`,
		label: 'Google rating',
		href: site.links.gReviews,
		stars: true
	},
	{
		icon: null,
		value: String(site.rating.reviews),
		label: 'Google reviews',
		href: site.links.gReviews
	},
	{
		icon: MapPin,
		value: 'Midnapore',
		label: 'Rabindra Nagar location',
		href: site.links.gMapsSearch
	},
	{
		icon: Heart,
		value: 'Patient-first',
		label: 'Focused on your comfort',
		href: '/about'
	}
];
---

<section class="relative z-10 -mt-4">
	<div class="editorial-container">
		<div
			class="grid gap-px overflow-hidden rounded-[1.75rem] border border-hairline bg-hairline shadow-card sm:grid-cols-2 lg:grid-cols-4"
			data-reveal-group
		>
			{items.map((item) => {
				const Icon = item.icon;
				const external = item.href.startsWith('http');
				return (
					<div class="bg-white px-6 py-7 transition-colors duration-300 hover:bg-offwhite" data-reveal-child>
						<a
							href={item.href}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener' : undefined}
							class="flex h-full flex-col gap-2"
						>
							<span class="flex items-center gap-2.5">
								{Icon ? <Icon size={17} class="text-teal" /> : <Stars value={site.rating.value} class="scale-90 origin-left" />}
							</span>
							<span class="font-display text-2xl font-extrabold text-navy">{item.value}</span>
							<span class="text-sm text-ink-soft">{item.label}</span>
						</a>
					</div>
				);
			})}
		</div>
	</div>
</section>
