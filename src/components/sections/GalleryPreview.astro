---
import { publishedGallery, galleryCategoryLabels } from '../../data/gallery';
import { site } from '../../data/site';
import { getIcon } from '../../lib/icons';
import SectionHeading from '../ui/SectionHeading.astro';

const Arrow = getIcon('arrow-right');
const Camera = getIcon('scan-face');

const placeholders = ['exterior', 'reception', 'waiting', 'consultation'] as const;
const spans = ['sm:col-span-2 sm:row-span-2', '', '', 'sm:col-span-2'];
---

<section class="section-pad bg-offwhite">
	<div class="editorial-container">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<SectionHeading
				eyebrow="Gallery"
				title="Inside the Chamber."
				titleBn="চেম্বারের ভেতরে"
				description="A look at the space where you are welcomed — exterior, reception, waiting area and consultation rooms."
			/>
			<a href="/gallery" class="btn btn-ghost shrink-0 text-sm" data-reveal>
				Open gallery
				<Arrow size={15} class="arrow" strokeWidth={2.2} />
			</a>
		</div>

		{publishedGallery.length > 0 ? (
			<div class="mt-12 grid auto-rows-[11rem] grid-cols-2 gap-4 sm:grid-cols-4 lg:auto-rows-[14rem]" data-reveal-group>
				{publishedGallery.slice(0, 7).map((g, i) => (
					<a
						href="/gallery"
						class={`group relative overflow-hidden rounded-2xl ${g.span === 'wide' ? 'col-span-2' : ''} ${g.span === 'tall' ? 'row-span-2' : ''}`}
						data-reveal-child
					>
						<img
							src={g.src}
							alt={g.alt}
							width="800"
							height="600"
							loading="lazy"
							class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
						/>
						<span class="absolute inset-0 bg-gradient-to-t from-navy/70 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
						<span class="absolute bottom-3 left-3 rounded-full bg-white/90 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-widest text-navy opacity-0 transition-opacity duration-500 group-hover:opacity-100">
							{galleryCategoryLabels[g.category]}
						</span>
					</a>
				))}
			</div>
		) : (
			<div class="mt-12 grid auto-rows-[10rem] grid-cols-2 gap-4 sm:grid-cols-4" data-reveal-group>
				{placeholders.map((key, i) => (
					<div
						class={`flex flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-navy/15 bg-white/60 p-5 text-center transition-colors duration-300 hover:border-teal/60 hover:bg-white ${spans[i] ?? ''}`}
						data-reveal-child
					>
						<span class="flex h-10 w-10 items-center justify-center rounded-xl bg-medical/10 text-medical">
							<Camera size={19} />
						</span>
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-navy">{galleryCategoryLabels[key]}</p>
						<p class="text-[0.7rem] text-ink-soft">Photo coming soon</p>
					</div>
				))}
			</div>
		)}

		{publishedGallery.length === 0 && (
			<p class="mt-6 text-center text-sm text-ink-soft" data-reveal>
				Real photographs of the chamber will be published here. Want a look before you visit?
				<a href={site.phone.tel} class="font-semibold text-medical underline-offset-2 hover:underline"> Give us a call.</a>
			</p>
		)}
	</div>
</section>
