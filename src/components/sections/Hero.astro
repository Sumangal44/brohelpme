---
import { site } from '../../data/site';
import { hasImage } from '../../lib/images';
import { getIcon } from '../../lib/icons';
import Stars from '../ui/Stars.astro';

const heroPhoto = hasImage(site.images.hero) ? site.images.hero : null;
const MapPin = getIcon('map-pin');
const Clock = getIcon('clock');
const Sparkles = getIcon('sparkles');
const Arrow = getIcon('arrow-right');
---

<section class="relative overflow-hidden bg-gradient-to-b from-white via-offwhite to-offwhite">
	<!-- decorative atmosphere -->
	<div class="pointer-events-none absolute -left-40 top-10 h-[30rem] w-[30rem] rounded-full bg-medical/10 blur-[130px]" data-parallax="30" aria-hidden="true"></div>
	<div class="pointer-events-none absolute -right-32 bottom-0 h-[26rem] w-[26rem] rounded-full bg-teal/15 blur-[120px]" data-parallax="45" aria-hidden="true"></div>

	<div class="editorial-container relative pb-16 pt-14 sm:pt-20 lg:pb-24 lg:pt-28">
		<div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
			<!-- Copy -->
			<div class="lg:col-span-7">
				<p class="eyebrow" data-hero>
					<span class="relative flex h-2 w-2">
						<span class="absolute inline-flex h-full w-full animate-pulse-soft rounded-full bg-teal"></span>
					</span>
					Midnapore · Established {site.established}
				</p>

				<h1 class="mt-7 text-[2.6rem] font-extrabold leading-[1.02] tracking-[-0.03em] sm:text-6xl lg:text-[4.4rem]">
					<span class="block" data-hero>Trusted Healthcare.</span>
					<span
						class="block bg-gradient-to-r from-medical via-medical to-teal bg-clip-text text-transparent"
						data-hero
					>
						A Better Tomorrow.
					</span>
				</h1>

				<p class="font-bengali mt-6 text-xl leading-relaxed text-medical sm:text-2xl" data-hero>
					{site.taglineBn}
				</p>

				<p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg" data-hero>
					Discover patient-focused healthcare services and experienced medical professionals at
					Kathamala Doctors Chamber, Midnapore.
				</p>

				<div class="mt-9 flex flex-wrap items-center gap-4" data-hero>
					<a href="/doctors" class="btn btn-primary">
						Explore Our Doctors
						<Arrow size={16} class="arrow" strokeWidth={2.2} />
					</a>
					<a href="/contact" class="btn btn-ghost">Contact Us</a>
				</div>

				<div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4" data-hero>
					<a
						href={site.links.gReviews}
						target="_blank"
						rel="noopener"
						class="group flex items-center gap-3"
					>
						<Stars value={site.rating.value} />
						<span class="text-sm">
							<strong class="font-bold text-navy">{site.rating.value}</strong>
							<span class="text-ink-soft">/ {site.rating.max}</span>
							<span class="text-ink-soft"> · {site.rating.reviews} Google reviews</span>
						</span>
					</a>
					<span class="hidden h-5 w-px bg-hairline sm:block"></span>
					<span class="flex items-center gap-2 text-sm font-medium text-ink-soft">
						<Sparkles size={16} class="text-teal" />
						Patient-focused care
					</span>
				</div>
			</div>

			<!-- Visual -->
			<div class="lg:col-span-5" data-hero>
				<div class="relative mx-auto max-w-md lg:max-w-none" data-parallax="18">
					<div
						class="relative aspect-[4/5] overflow-hidden rounded-[2.5rem] shadow-float ring-1 ring-navy/10"
						data-reveal-mask
					>
						{heroPhoto ? (
						<img
							src={heroPhoto}
							alt="Kathamala Doctors Chamber"
							width="900"
							height="1125"
							fetchpriority="high"
							class="h-full w-full object-cover"
						/>
					) : (
						<>
							{/* Editorial art panel until a real photograph is supplied */}
							<div class="absolute inset-0 bg-gradient-to-br from-navy via-navy-700 to-medical"></div>
							<svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 500" fill="none" aria-hidden="true">
								<circle cx="320" cy="90" r="150" stroke="rgba(87,199,187,0.28)" stroke-width="1.2" />
								<circle cx="320" cy="90" r="110" stroke="rgba(87,199,187,0.18)" stroke-width="1.2" />
								<circle cx="60" cy="430" r="170" stroke="rgba(255,255,255,0.12)" stroke-width="1.2" />
								<path
									d="M-10 260 H110 l22 -56 32 132 30 -118 24 66 18 -24 H410"
									stroke="rgba(87,199,187,0.85)"
									stroke-width="3"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="ecg"
								/>
								<path
									d="M-10 320 H80 l18 -40 24 96 22 -86 16 48 14 -18 H410"
									stroke="rgba(255,255,255,0.25)"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<p class="font-bengali absolute bottom-8 left-8 right-8 text-sm leading-relaxed text-white/70">
								{site.nameBn}
							</p>
						</>
					)}
					</div>

					<!-- Floating info cards -->
					<div class="absolute -left-4 top-8 rounded-2xl border border-white/70 bg-white/90 px-4 py-3 shadow-card backdrop-blur sm:-left-8">
						<p class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-ink-soft">Google rating</p>
						<p class="mt-1 flex items-center gap-2">
							<span class="font-display text-xl font-extrabold text-navy">{site.rating.value}</span>
							<Stars value={site.rating.value} />
						</p>
						<p class="text-[0.7rem] text-ink-soft">{site.rating.reviews} reviews</p>
					</div>

					<div class="absolute -right-3 bottom-24 rounded-2xl border border-white/70 bg-white/90 px-4 py-3 shadow-card backdrop-blur sm:-right-6">
						<p class="flex items-center gap-2 text-xs font-semibold text-ink-soft">
							<Clock size={14} class="text-teal" />
							{site.hours[0].time}
						</p>
						<p class="mt-0.5 text-[0.7rem] text-ink-soft">Mon – Sun</p>
					</div>

					<a
						href={site.links.gMapsSearch}
						target="_blank"
						rel="noopener"
						class="absolute -bottom-5 left-6 flex items-center gap-2.5 rounded-2xl border border-white/70 bg-white/95 px-4 py-3 shadow-card backdrop-blur transition-transform duration-300 hover:-translate-y-1 sm:left-10"
					>
						<span class="flex h-9 w-9 items-center justify-center rounded-xl bg-medical/10 text-medical">
							<MapPin size={17} />
						</span>
						<span class="leading-tight">
							<span class="block text-xs font-bold text-navy">Rabindra Nagar</span>
							<span class="block text-[0.7rem] text-ink-soft">Midnapore, West Bengal</span>
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.ecg {
		stroke-dasharray: 1400;
		stroke-dashoffset: 1400;
		animation: ecg-draw 5s ease-in-out 0.8s infinite;
	}
	@keyframes ecg-draw {
		0% {
			stroke-dashoffset: 1400;
		}
		45%,
		100% {
			stroke-dashoffset: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ecg {
			animation: none;
			stroke-dashoffset: 0;
		}
	}
</style>
