---
import { site } from '../../data/site';
import { getIcon } from '../../lib/icons';
import Stars from '../ui/Stars.astro';

const Quote = getIcon('quote');
const Arrow = getIcon('arrow-up-right');
---

<section class="section-pad bg-white">
	<div class="editorial-container">
		<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
			<!-- Rating showcase -->
			<div class="lg:col-span-5" data-reveal>
				<div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-navy to-navy-700 p-9 text-white sm:p-11">
					<svg class="pointer-events-none absolute -right-6 -top-6 h-40 w-40 opacity-10" viewBox="0 0 100 100" fill="none" aria-hidden="true">
						<path d="M50 4 L61 39 H97 L68 60 L79 95 L50 74 L21 95 L32 60 L3 39 H39 Z" stroke="white" stroke-width="3" stroke-linejoin="round" />
					</svg>

					<p class="text-xs font-bold uppercase tracking-[0.25em] text-teal-light">Google rating</p>
					<p class="mt-5 font-display text-7xl font-extrabold leading-none sm:text-8xl">{site.rating.value}</p>
					<div class="mt-4 flex items-center gap-3">
						<Stars value={site.rating.value} />
						<span class="text-sm text-white/60">out of {site.rating.max}</span>
					</div>
					<p class="mt-3 text-sm text-white/70">
						Based on <strong class="text-white">{site.rating.reviews} Google reviews</strong>
					</p>
					<a href={site.links.gReviews} target="_blank" rel="noopener" class="btn btn-teal mt-7 text-sm">
						Read reviews on Google
						<Arrow size={15} class="arrow" strokeWidth={2.2} />
					</a>
				</div>
			</div>

			<!-- Honest word -->
			<div class="lg:col-span-7">
				<p class="eyebrow" data-reveal>Reviews</p>
				<h2 class="mt-5 text-3xl font-extrabold leading-[1.08] sm:text-4xl lg:text-[2.9rem]" data-reveal>
					Their words, not ours.
				</h2>
				<span class="mt-6 block text-teal" data-reveal>
					<Quote size={44} strokeWidth={1.4} />
				</span>
				<p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg" data-reveal>
					We don't write our own testimonials. Every review on our Google listing is written by
					real patients, published publicly and left untouched — the good ones and the ones that
					push us to do better.
				</p>
				<div class="mt-7 flex flex-wrap gap-4" data-reveal>
					<a href={site.links.gReviews} target="_blank" rel="noopener" class="btn btn-primary text-sm">
						See all {site.rating.reviews} reviews
						<Arrow size={15} class="arrow" strokeWidth={2.2} />
					</a>
					<a href="/appointment" class="btn btn-ghost text-sm">Book an appointment</a>
				</div>
			</div>
		</div>
	</div>
</section>
